# ComGuard configuration — copy to .env and fill in real values.
# NEVER commit the filled-in .env. Every value below is a placeholder.

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=pick-any-string-and-use-the-same-one-in-the-meta-dashboard

# Meta signs every webhook with your App Secret (App Dashboard → Settings →
# Basic). Without this, anyone who learns your URL can POST fake reports.
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=comguard

# ── Model ────────────────────────────────────────────────────────────────────
# Gemma is both the conversational agent and the vision model (OCR, hazard
# classification, synthetic-image checks). There is no separate detector.
GEMMA_BASE_URL=https://your-inference-host/v1
GEMMA_MODEL=google/gemma-4-E4B-it
API_KEY=your-inference-api-key
# Optional: a different checkpoint for image work. Defaults to GEMMA_MODEL.
# GEMMA_VISION_MODEL=

# ── Retrieval corpus ─────────────────────────────────────────────────────────
# Build with:  python ingest_corpus.py ./corpus
QWEN_EMBED_URL=https://your-embedding-host/v1
QWEN_EMBED_API_KEY=your-embedding-key
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
COMGUARD_CHROMA_PATH=comguard_chroma_store
COMGUARD_CHROMA_COLLECTION=COMGUARD_CORPUS

# ── Translation ──────────────────────────────────────────────────────────────
# One endpoint serving every pair. Leave empty to use the per-language
# <LANG>_NLLB_URL entries below instead.
TRANSLATOR_URL=https://your-translation-host

# ── Languages ────────────────────────────────────────────────────────────────
# A language appears in the menu only when its STT or TTS endpoint is set here.
# That is the whole switch — no code change is needed to add one.

# English (always available; the pivot language the model reasons in)
ENGLISH_STT_API_URL=https://your-english-stt-host/v1
ENGLISH_STT_FALLBACK_URL=https://your-english-stt-fallback/v1
ENGLISH_TTS_BASE_URL=https://your-tts-host/en/v1
ENGLISH_TTS_FALLBACK_URL=
ENGLISH_TTS_MODEL=nigerian-english-xtts
ENGLISH_TTS_VOICE=female2

# Yoruba
YORUBA_STT_API_URL=https://your-stt-host/yo/v1
YORUBA_STT_FALLBACK_URL=
YORUBA_TTS_BASE_URL=https://your-tts-host/yo/v1
YORUBA_TTS_FALLBACK_URL=
YORUBA_TTS_MODEL=yoruba-tts-model
YORUBA_TTS_VOICE=female
YORUBA_NLLB_URL=https://your-nllb-host/yoruba/v1

# Arabic — TEXT ONLY. This single line turns it on; Gemma reads and writes
# Arabic well, so the conversation works fully in text.
ARABIC_ENABLED=true

# Leave the speech endpoints below unset until you have models that genuinely
# speak and hear Arabic. The Chatterbox TTS deployment used here loads adapters
# for en/yo/ha/ig only: asked for "ar" it returns 400, and handed Arabic text
# with no language tag it produces fluent audio of words nobody wrote. Setting
# ARABIC_TTS_BASE_URL to that service would ship confident wrong speech to
# people in an emergency, which is why it stays empty rather than "close enough".
#
# Fill either one in and that half switches on by itself — no code change.
# ARABIC_STT_API_URL=
# ARABIC_STT_FALLBACK_URL=
# ARABIC_TTS_BASE_URL=
# ARABIC_TTS_FALLBACK_URL=
# ARABIC_TTS_MODEL=arabic-tts-model
# ARABIC_TTS_VOICE=female
# ARABIC_NLLB_URL=

# French — TEXT ONLY, same reason as Arabic but a different failure. The TTS
# rejects "fr"; fed French untagged it speaks recognisable but unreliable
# French — in testing "Ne passez pas par cette route" came back as
# "ni pas ses passes passes de taroute", losing the negation. A safety
# instruction whose "do not" dissolves is worse than no audio, so leave the
# speech endpoints unset until a real French voice is available.
FRENCH_ENABLED=true

# FRENCH_STT_API_URL=
# FRENCH_STT_FALLBACK_URL=
# FRENCH_TTS_BASE_URL=
# FRENCH_TTS_FALLBACK_URL=
# FRENCH_TTS_MODEL=french-tts-model
# FRENCH_TTS_VOICE=female
# FRENCH_NLLB_URL=

# ── Reporter protection ──────────────────────────────────────────────────────
# A long random string. Reporter phone numbers are HMAC'd with it to produce the
# pseudonym that appears on reports. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it breaks the link between a person's past and future reports, which
# weakens corroboration but never discloses anything.
REPORT_SALT=generate-a-long-random-string

# ── Corroboration and alerting ───────────────────────────────────────────────
# How many INDEPENDENT reporters must describe the same thing nearby before a
# community alert can go out. Lowering this to 1 turns the service into a rumour
# amplifier — do not.
CORROBORATION_THRESHOLD=2
CORROBORATION_RADIUS_KM=3
CORROBORATION_WINDOW_MINUTES=180

# How close a resident must be to a confirmed incident to be warned.
ALERT_BROADCAST_RADIUS_KM=5

# Never re-broadcast the same incident inside this window.
ALERT_COOLDOWN_MINUTES=120

# ── Authority routing ────────────────────────────────────────────────────────
# Anonymised reports are POSTed here as JSON. Leave empty during development —
# reports are still stored and visible on the dashboard, just not pushed out.
AUTHORITY_WEBHOOK_URL=
AUTHORITY_WEBHOOK_TOKEN=

# Per-category overrides, named AUTHORITY_WEBHOOK_<CATEGORY>. Categories:
# FLOOD FIRE ROAD_DAMAGE BLOCKED_ROUTE STRUCTURAL_COLLAPSE UNREST
# FAKE_NOTICE ILLEGAL_LEVY UNLAWFUL_CHECKPOINT FORGED_RECEIPT OTHER
# AUTHORITY_WEBHOOK_FLOOD=https://sema.example/intake
# AUTHORITY_WEBHOOK_ILLEGAL_LEVY=https://revenue-service.example/intake

# ── Dispatcher dashboard (/reports/*) ────────────────────────────────────────
# Reports describe where incidents happened, so with no password set these
# endpoints refuse to serve rather than defaulting to open.
# Create a password FOR THIS DASHBOARD ONLY — never reuse an account password,
# since this file sits in plaintext on the server.
# Comma-separated to allow rotation without a gap.
DASHBOARD_USER=dispatcher@your-org.example
DASHBOARD_PASSWORD=set-a-dashboard-only-password
DASHBOARD_ALLOWED_ORIGINS=https://your-dashboard-site.example

# ── Local emergency numbers ──────────────────────────────────────────────────
# Surfaced whenever a report is life-threatening. Change for other regions.
EMERGENCY_NUMBERS=112 (national emergency) or 767 (Lagos LASEMA)

PORT=5001
